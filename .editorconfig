# EditorConfig helps maintain consistent coding styles
root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{cs,csx}]
indent_size = 4

[*.{js,jsx,ts,tsx,json,css,scss}]
indent_size = 2

[*.{html,htm}]
indent_size = 2

[*.{yaml,yml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Dockerfile]
indent_size = 4

[*.csproj]
indent_size = 2

[*.sln]
indent_style = tab
